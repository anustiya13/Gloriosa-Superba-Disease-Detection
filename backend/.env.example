# ============================================================
# .env.example — Environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/gloriosa_ai

# ── JWT Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Application ──────────────────────────────────────────────
APP_NAME=Gloriosa AI
APP_VERSION=1.0.0
DEBUG=true

# ── Mock Mode ───────────────────────────────────────────────
# Set MOCK_AI=true to use mock predictions (no real model needed)
# Set MOCK_AI=false when the real trained model is available
MOCK_AI=true

# ── Mock OTP ─────────────────────────────────────────────────
# Set MOCK_OTP=true to use fixed OTP "123456" for testing
# Set MOCK_OTP=false and configure SMS_PROVIDER for production
MOCK_OTP=true

# ── SMS Provider (for production) ────────────────────────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Upload Settings ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
